# TEMPLATE ONLY. Merge settings into your EXISTING .env; do not replace real credentials.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
OPENAI_API_KEY=
ASTRA_MODEL=gpt-6-astra

DB_HOST=localhost
DB_PORT=5432
DB_NAME=astra_trader
DB_USER=postgres
DB_PASSWORD=

# Same paper-only operational defaults as the uploaded US-market upgrade.
OPS_FEED=iex
OPS_ADJUSTMENT=raw
OPS_BATCH_SIZE=20
OPS_BACKFILL_SESSIONS=450
OPS_FULL_REFRESH_DAYS=7
OPS_QUOTE_MAX_AGE_SECONDS=60
OPS_PAPER_MAX_ORDER_USD=1000

# One supported research policy. Actual model key and prices are checked separately.
ASTRA_FINALISTS=3
ASTRA_MAX_PICKS=2
ASTRA_FINALISTS_PER_SECTOR=2
ASTRA_NEWS_PER_FINALIST=3
ASTRA_MAX_INPUT_TOKENS=8000
ASTRA_MAX_OUTPUT_TOKENS=4000
ASTRA_MAX_CALL_USD=0.35
ASTRA_BUDGET_7D_USD=1.00
ASTRA_MAX_CALLS_7D=2
ASTRA_MIN_HOURS_BETWEEN_CALLS=6

# Default OFF. Explicit exact-order approval is still required even when true.
ASTRA_ENABLE_PAPER_SUBMISSION=false
